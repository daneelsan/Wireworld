Cell["\<\
Wireworld is a Turing-complete cellular automaton first proposed by Brian \
Silverman in 1987 suited for simulating logic gates and other real-world \
computer elements.\
\>", "Text",
 TaggingRules->{},
 CellID->682099647,ExpressionUUID->"98c20501-299d-4578-ab1e-a87fe79093f9"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Details",
 Cell[BoxData[
  PaneSelectorBox[{True->
   TemplateBox[{"Details", 
     Cell[
      BoxData[
       FrameBox[
        Cell[
        "Details may include a long description of the resource's contents, \
